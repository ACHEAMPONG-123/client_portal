// Prisma Schema for Multi-Tenant Agency Client Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum TenantSize {
  STARTUP
  SMALL_BUSINESS
  MEDIUM_BUSINESS
  ENTERPRISE
}

enum ClientStatus {
  LEAD
  PROPOSAL_SENT
  ONBOARDING
  ACTIVE
  ON_HOLD
  COMPLETED
  INACTIVE
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectType {
  WEBSITE
  BRANDING
  SEO
  SOCIAL_MEDIA
  ADVERTISING
  CONTENT_CREATION
  MARKETING_STRATEGY
  OTHER
}

enum ProjectStatus {
  PLANNING
  ONBOARDING
  IN_PROGRESS
  REVIEW
  WAITING_FOR_CLIENT
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  CLIENT_VISIBLE
  CLIENT_REVIEW
  COMPLETED
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  CLIENT_VISIBLE
  CLIENT_REVIEWED
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum DocumentType {
  CONTRACT
  PROPOSAL
  INVOICE
  BRAND_GUIDE
  BRIEF
  REPORT
  DESIGN_FILE
  CONTENT
  MEETING_NOTES
  ASSET
  OTHER
}

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ARCHIVED
}

enum ResourceType {
  BRAND_ASSET
  WEBSITE_FILES
  MARKETING_REPORTS
  INVOICES
  OTHER
}

enum MeetingType {
  STRATEGY
  SUPPORT
  REVIEW
  TRAINING
  CONSULTATION
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TicketCategory {
  WEBSITE
  DESIGN
  CONTENT
  MARKETING
  TECH_SUPPORT
  GENERAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

// ==========================================
// TENANT / COMPANY MODEL
// ==========================================
model Tenant {
  id                  String               @id @default(cuid())
  name                String
  logo                String?
  industry            String?
  companySize         TenantSize           @default(SMALL_BUSINESS)
  website             String?
  email               String?
  phone               String?
  primaryContact      String?
  accountManagerId    String?
  clientStatus        ClientStatus         @default(ONBOARDING)
  servicePackages     String?              @db.Text // JSON string array of active packages
  monthlyRetainerValue Decimal              @default(0.00) @db.Decimal(10, 2)
  contractStart       DateTime?
  contractEnd         DateTime?
  renewalDate         DateTime?
  priorityLevel       PriorityLevel        @default(MEDIUM)
  lastContactDate     DateTime?
  nextFollowUpDate    DateTime?
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  users               User[]
  projects            Project[]
  tasks               Task[]
  deliverables        Deliverable[]
  approvals           Approval[]
  documents           Document[]
  driveResources      GoogleDriveResource[]
  meetings            Meeting[]
  supportTickets      SupportTicket[]
  invoices            Invoice[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([clientStatus])
  @@index([priorityLevel])
}

// ==========================================
// AUTH & RBAC MODELS
// ==========================================
model Role {
  id              String           @id @default(cuid())
  name            String           @unique // e.g. SUPER_ADMIN, CLIENT_ADMIN, etc.
  description     String?
  isSystem        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique // e.g. clients.view, projects.create
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String
  title           String?
  avatarUrl       String?
  phone           String?
  status          UserStatus    @default(ACTIVE)
  roleId          String
  tenantId        String?       // Null for Agency Staff / Super Admin

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  role            Role          @relation(fields: [roleId], references: [id])
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Reverse relations
  managedProjects      Project[]             @relation("ProjectManager")
  createdTasks         Task[]                @relation("TaskCreator")
  assignedTasks        Task[]                @relation("TaskAssignee")
  createdDeliverables  Deliverable[]         @relation("DeliverableCreator")
  submittedVersions    DeliverableVersion[]  @relation("VersionSubmitter")
  givenApprovals       Approval[]            @relation("ApprovalReviewer")
  requestedRevisions   RevisionRequest[]     @relation("RevisionRequester")
  assignedRevisions    RevisionRequest[]     @relation("RevisionAssignee")
  uploadedDocuments    Document[]            @relation("DocumentUploader")
  hostedMeetings       Meeting[]             @relation("MeetingHost")
  submittedTickets     SupportTicket[]       @relation("TicketSubmitter")
  assignedTickets      SupportTicket[]       @relation("TicketAssignee")
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([tenantId])
  @@index([roleId])
  @@index([status])
}

// ==========================================
// PROJECT & TASK MANAGEMENT
// ==========================================
model Project {
  id                    String        @id @default(cuid())
  name                  String
  tenantId              String
  projectManagerId      String?
  projectType           ProjectType   @default(WEBSITE)
  status                ProjectStatus @default(PLANNING)
  priority              PriorityLevel @default(MEDIUM)
  startDate             DateTime?
  deadline              DateTime?
  completionDate        DateTime?
  progress              Int           @default(0) // 0 to 100
  budget                Decimal       @default(0.00) @db.Decimal(10, 2)
  currency              String        @default("USD")
  clientApprovalRequired Boolean       @default(true)
  description           String?       @db.Text
  internalNotes         String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectManager        User?         @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)

  tasks                 Task[]
  deliverables          Deliverable[]
  approvals             Approval[]
  documents             Document[]
  driveResources        GoogleDriveResource[]
  invoices              Invoice[]

  @@index([tenantId])
  @@index([status])
  @@index([projectManagerId])
}

model Task {
  id               String        @id @default(cuid())
  title            String
  projectId        String
  tenantId         String
  creatorId        String
  assigneeId       String?
  status           TaskStatus    @default(ASSIGNED)
  priority         PriorityLevel @default(MEDIUM)
  deadline         DateTime?
  description      String?       @db.Text
  internalNotes    String?       @db.Text
  clientVisibility Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator          User          @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee         User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  deliverables     Deliverable[]

  @@index([tenantId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

// ==========================================
// DELIVERABLES & APPROVAL WORKFLOW
// ==========================================
model Deliverable {
  id                    String              @id @default(cuid())
  name                  String
  projectId             String
  taskId                String?
  tenantId              String
  creatorId             String
  currentVersion        String              @default("V1")
  status                DeliverableStatus   @default(SUBMITTED)
  clientVisible         Boolean             @default(false)
  clientApprovalRequired Boolean             @default(true)
  approvalStatus        ApprovalStatus      @default(PENDING)
  internalNotes         String?             @db.Text
  clientDescription     String?             @db.Text
  externalDriveLink     String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                  Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator               User                @relation("DeliverableCreator", fields: [creatorId], references: [id])

  versions              DeliverableVersion[]
  approvals             Approval[]
  revisionRequests      RevisionRequest[]

  @@index([tenantId])
  @@index([projectId])
  @@index([clientVisible])
  @@index([approvalStatus])
}

model DeliverableVersion {
  id                String            @id @default(cuid())
  deliverableId     String
  versionLabel      String            // e.g. V1, V2, V3, Final
  submittedById     String
  submissionDate    DateTime          @default(now())
  externalDriveLink String
  description       String?           @db.Text
  reviewStatus      DeliverableStatus @default(SUBMITTED)
  revisionNotes     String?           @db.Text
  createdAt         DateTime          @default(now())

  deliverable       Deliverable       @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  submittedBy       User              @relation("VersionSubmitter", fields: [submittedById], references: [id])
  revisionRequests  RevisionRequest[]

  @@index([deliverableId])
}

model Approval {
  id               String         @id @default(cuid())
  deliverableId    String?
  projectId        String?
  tenantId         String
  reviewerId       String
  status           ApprovalStatus
  comment          String?        @db.Text
  requestedChanges String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  deliverable      Deliverable?   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewer         User           @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId])
  @@index([deliverableId])
}

model RevisionRequest {
  id            String             @id @default(cuid())
  deliverableId String
  versionId     String?
  requestedById String
  assignedToId  String?
  description   String             @db.Text
  status        String             @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  deliverable   Deliverable        @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  version       DeliverableVersion?@relation(fields: [versionId], references: [id], onDelete: SetNull)
  requestedBy   User               @relation("RevisionRequester", fields: [requestedById], references: [id])
  assignedTo    User?              @relation("RevisionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([deliverableId])
}

// ==========================================
// DOCUMENTS & GOOGLE DRIVE RESOURCES
// ==========================================
model Document {
  id                  String         @id @default(cuid())
  name                String
  tenantId            String
  projectId           String?
  uploadedById        String
  documentType        DocumentType   @default(OTHER)
  status              DocumentStatus @default(DRAFT)
  uploadDate          DateTime       @default(now())
  version             String         @default("1.0")
  externalLink        String
  clientVisible       Boolean        @default(false)
  confidential        Boolean        @default(false)
  relatedDeliverables String?
  description         String?        @db.Text
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy          User           @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([clientVisible])
}

model GoogleDriveResource {
  id            String       @id @default(cuid())
  tenantId      String
  projectId     String?
  name          String
  resourceType  ResourceType @default(OTHER)
  url           String
  description   String?      @db.Text
  clientVisible Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientVisible])
}

// ==========================================
// MEETINGS, SUPPORT & BILLING
// ==========================================
model Meeting {
  id                String        @id @default(cuid())
  tenantId          String
  type              MeetingType   @default(STRATEGY)
  hostId            String?
  attendees         String?       @db.Text // JSON array of email strings
  dateTime          DateTime
  timeZone          String        @default("UTC")
  externalBookingId String?
  status            MeetingStatus @default(SCHEDULED)
  notes             String?       @db.Text
  bookingUrl        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host              User?         @relation("MeetingHost", fields: [hostId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([dateTime])
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  tenantId        String
  submittedById   String
  subject         String
  category        TicketCategory @default(GENERAL)
  priority        PriorityLevel  @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  assigneeId      String?
  description     String         @db.Text
  internalNotes   String?        @db.Text
  resolutionNotes String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy     User           @relation("TicketSubmitter", fields: [submittedById], references: [id])
  assignee        User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([submittedById])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  tenantId      String
  projectId     String?
  amount        Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0.00) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  dueDate       DateTime
  paidDate      DateTime?
  status        InvoiceStatus @default(UNPAID)
  paymentMethod String?
  receiptUrl    String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String?
  type       String
  title      String
  message    String   @db.Text
  entityType String?
  entityId   String?
  readStatus Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([readStatus])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorId     String
  action      String
  entityType  String
  entityId    String?
  description String   @db.Text
  metadata    String?  @db.Text // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([actorId])
  @@index([createdAt])
}
